# Build output
dist/
node_modules/

# NEVER commit fleet snapshots.
#
# This repository is PUBLIC. Even though `tools/snapshot.mjs` only ever writes
# AES-256-GCM ciphertext, publishing the encrypted fleet inventory into the
# source tree would pin its salt and ciphertext into git history forever, where
# a future passphrase compromise would retroactively expose every historical
# snapshot. The snapshot belongs in the deployed gh-pages artifact, not here.
public/data/
*.enc.json

# TypeScript incremental build state
*.tsbuildinfo

# Secrets. The repo is PUBLIC — the dashboard passphrase must never be committed.
# Keep the canonical copy in a secret manager (e.g. Vault secret/rch-fleet-dashboard).
.env
.env.*
!.env.example

# Rolling aggregate history sidecar (plaintext, never published)
.snapshot-history.json

# bundled serverless function output
.vercel-fn/
.vercel/

# Perf/visual test OUTPUT. Never commit: a V8 .cpuprofile embeds absolute
# source paths (it carried /Users/<name> into a public repo), and these are
# regenerated by `npm run perf` anyway — perf.mjs only writes a baseline, it
# never reads one back.
tests/artifacts/

# ssh self-check cache for the API transport (plaintext, never published)
.selfcheck-cache.json

{
  "name": "rch-fleet-dashboard",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Password-gated, client-side-encrypted monitoring dashboard for an rch build fleet.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "snapshot": "node tools/snapshot.mjs",
    "deploy": "bash scripts/deploy.sh",
    "test:e2e": "node tests/e2e.mjs",
    "serve:dist": "python3 -m http.server 4174 --directory dist",
    "build:api": "esbuild api/fleet.mjs --bundle --platform=node --format=esm --target=node20 --loader:.json=json --outfile=.vercel-fn/index.mjs",
    "test:endpoint": "node tests/endpoint.mjs",
    "llm": "node tools/fleet-llm.mjs"
  },
  "dependencies": {
    "@toon-format/toon": "^4.1.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "playwright": "^1.62.1",
    "typescript": "^5.9.3",
    "vite": "^7.1.7"
  }
}

# Copy to .env and fill in. NEVER commit the real .env.
# The passphrase decrypts the published snapshot; it is the only thing standing
# between a public URL and your fleet inventory. Use 24+ random characters, e.g.
#   head -c 32 /dev/urandom | base64 | tr '+/' '-_' | tr -d '='
# Quote every value: `set -a; . ./.env` word-splits unquoted values and will
# happily execute the tail of one as a command.
RCH_DASH_PASSPHRASE=''
# Dev machines (boxes that RUN rch). Two spellings per entry:
#   name                 probe over ssh (`rch status --json` etc.)
#   name=100.x.y.z:9101  ask rchd's tailnet status API ([api] bind = "tailscale"
#                        in that box's config.toml) — sub-second; ssh is then
#                        used only for the doctor/shim/hook self-checks
# Use `local` for the machine you collect from, so it monitors itself too.
RCH_DASH_DISPATCHERS='host-a=100.64.1.2:9101,host-b=100.64.1.3:9101,local=100.64.1.1:9101'
# The bearer token every rchd's [api] was configured with (api.token_file).
RCH_DASH_API_TOKEN=''
RCH_DASH_LABEL='my rch fleet'
# Vercel Blob URL the publish tick writes to (scripts/publish-snapshot.sh prints
# it on first run). The app and /api/fleet fetch it at runtime; leave empty for
# a static-only deployment (GitHub Pages).
RCH_DASH_DATA_URL=''

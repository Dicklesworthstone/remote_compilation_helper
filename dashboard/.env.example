# Copy to .env and fill in. NEVER commit the real .env.
# The passphrase decrypts the published snapshot; it is the only thing standing
# between a public URL and your fleet inventory. Use 24+ random characters, e.g.
#   head -c 32 /dev/urandom | base64 | tr '+/' '-_' | tr -d '='
# Quote every value: `set -a; . ./.env` word-splits unquoted values and will
# happily execute the tail of one as a command.
RCH_DASH_PASSPHRASE=''
# ssh targets that RUN rch (dev machines). Use `local` for the machine you
# collect from, so it monitors itself too.
RCH_DASH_DISPATCHERS='host-a,host-b,local'
RCH_DASH_LABEL='my rch fleet'
